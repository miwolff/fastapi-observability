{
  "uid": "scheduled-pipelines",
  "title": "Scheduled Pipelines",
  "tags": [
    "pipelines",
    "observability"
  ],
  "description": "Batch-job observability: RED metrics derived from spans, service map, run traces and job logs.",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Runs (last 1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "pipeline.run spans from Tempo span metrics. ERROR = aborted run or at least one failed record.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (service, status_code) (round(increase(traces_spanmetrics_calls_total{span_name=\"pipeline.run\", service=~\"pipelines-.*\"}[1h])))",
          "legendFormat": "{{service}} {{status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*ERROR.*"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Record throughput by outcome",
      "description": "pipeline.record spans per second. Records are not Prometheus labels; use Tempo/Loki for per-record detail.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (service, status_code) (rate(traces_spanmetrics_calls_total{span_name=\"pipeline.record\", service=~\"pipelines-.*\"}[$__rate_interval]))",
          "legendFormat": "{{service}} {{status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Record latency p95 (with exemplars)",
      "description": "Click an exemplar dot to open the trace of a slow record.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(traces_spanmetrics_latency_bucket{span_name=\"pipeline.record\", service=~\"pipelines-.*\"}[$__rate_interval])))",
          "legendFormat": "{{service}} p95",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "nodeGraph",
      "title": "Service map",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "Built by Tempo's service-graph processor from CLIENT/SERVER span pairs: pipelines -> app-a -> app-b/app-c.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "serviceMap"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Recent pipeline runs",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "Latest pipeline.run traces. Click a trace ID to open the waterfall, then jump to logs.",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "limit": 20,
          "tableType": "traces",
          "query": "{ name = \"pipeline.run\" } | select(span.pipeline.run_id, span.pipeline.failed_records, span.pipeline.target, span.pipeline.app_version)"
        }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Pipeline warnings and errors",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "OTLP logs from pipeline jobs. run_id, record_id and trace_id are Loki structured metadata.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{service_name=~\"pipelines-.*\"} | severity_text=~\"WARN.*|ERROR|FATAL\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ],
  "links": [
    {
      "title": "FastAPI Observability",
      "type": "dashboards",
      "tags": [],
      "url": "/d/fastapi-observability",
      "asDropdown": false
    }
  ]
}
