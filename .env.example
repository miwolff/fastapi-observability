# Generate a unique value with: openssl rand -base64 32
GRAFANA_ADMIN_PASSWORD=replace-with-a-unique-password

# Optional FastAPI setting for running main.py outside Docker Compose. Compose fixes each
# service identity as app-a, app-b, or app-c so the dashboard labels remain consistent.
# Default: app
APP_NAME=app

# Optional FastAPI listen port for running main.py outside Docker Compose. The Compose
# stack fixes this at 8000 because its host ports, health checks, and service URLs use it.
# Default: 8000
EXPOSE_PORT=8000

# Optional OTLP/gRPC trace collector endpoint, passed to each Compose app. Default: tempo:4317
OTLP_GRPC_ENDPOINT=tempo:4317

# Optional: use plaintext OTLP/gRPC for the internal Compose network. Compose explicitly
# supplies true; standalone application runs default to false and require an explicit opt-in.
OTLP_INSECURE=true

# Optional downstream services for the /chain demonstration endpoint, passed to each Compose app.
# Defaults: app-b and app-c
TARGET_ONE_HOST=app-b
TARGET_TWO_HOST=app-c

# Scheduled pipelines (pipelines/ and the Ofelia scheduler).
# Owner of data/pipeline-output/ for job containers. On Linux set these to `id -u` / `id -g`.
# Default: 10001
PIPELINE_UID=10001
PIPELINE_GID=10001

# Target name or alias from etc/pipelines/targets.toml that jobs call. Default: latest
FASTAPI_TARGET=latest

# Loki's OTLP/HTTP logs endpoint used by pipeline jobs. Default: http://loki:3100/otlp/v1/logs
OTLP_LOGS_ENDPOINT=http://loki:3100/otlp/v1/logs
